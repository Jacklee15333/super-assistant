{"url": "https://www.douyin.com/video/7592109466875661609", "link": false, "lang": "auto", "local_path": "", "segments": [{"start": 0.0, "text": "哎呀恭喜恭喜啊祝贺祝贺祝贺卢比奥喜迪现代总督新头衔", "end": 4.36}, {"start": 4.36, "text": "大家也有幸见到新殖民幻哥出道了", "end": 7.16}, {"start": 7.16, "text": "这老特呀是真有活啊", "end": 8.96}, {"start": 8.96, "text": "把21世纪玩成了大航海时代了", "end": 11.26}, {"start": 11.26, "text": "祖传手机不能丢对吧", "end": 13.3}, {"start": 13.3, "text": "总督这个称谓大家应该都耳熟吧", "end": 15.36}, {"start": 15.36, "text": "卢比奥一定也很开心", "end": 16.9}, {"start": 16.9, "text": "那可是个肥柴呀肥的流油", "end": 18.94}, {"start": 18.94, "text": "当年英女王任命的总督", "end": 20.74}, {"start": 20.74, "text": "那就是土皇帝啊及行政立法军事大权于一身啊", "end": 24.58}, {"start": 24.58, "text": "瑞拉人民有福了", "end": 25.86}, {"start": 25.86, "text": "用我们某些狗腿子的话说", "end": 27.64}, {"start": 27.64, "text": "你们将享受文明自由", "end": 29.94}, {"start": 29.94, "text": "将过上那种我管你你要听话呀", "end": 32.24}, {"start": 32.24, "text": "不服我就揍你的幸福生活", "end": 34.68}, {"start": 34.68, "text": "老特就这一点好他不装", "end": 37.08}, {"start": 37.08, "text": "比当年的海盗还明火之杖的", "end": 39.0}, {"start": 39.0, "text": "那海盗啊是抢完还走呢", "end": 40.8}, {"start": 40.8, "text": "人家谱子直接要管理你", "end": 42.6}, {"start": 42.6, "text": "你看看这管理俩字用的是真妙啊", "end": 45.68}, {"start": 45.68, "text": "人家路彪也会做人呢", "end": 47.08}, {"start": 47.08, "text": "老特给他俩人家兜得住", "end": 48.88}, {"start": 48.88, "text": "你看人家说了是去打击谋品的", "end": 51.4}, {"start": 51.4, "text": "是为那里的人民谋福祉的", "end": 53.68}, {"start": 53.68, "text": "这会得挺累吧", "end": 55.2}, {"start": 55.2, "text": "费力不讨好对不对", "end": 56.94}, {"start": 56.94, "text": "所以辛苦了路彪抓紧时间吧啊", "end": 59.8}, {"start": 59.8, "text": "我看网上有不少的文明本都发视频说了", "end": 62.2}, {"start": 62.2, "text": "人们都在狂欢感谢美国", "end": 64.5}, {"start": 64.5, "text": "对对对应该感谢呀", "end": 66.04}, {"start": 66.04, "text": "得发自内心的感谢谱子", "end": 67.66}, {"start": 67.66, "text": "给世界带去文明", "end": 68.94}, {"start": 68.94, "text": "感谢马斯克带去免费宽待对不对", "end": 71.6}, {"start": 71.6, "text": "感谢路彪的管理", "end": 73.5}, {"start": 73.5, "text": "将来还会出现更多的总督呢", "end": 75.5}, {"start": 75.5, "text": "古巴的总督啊", "end": 76.4}, {"start": 76.4, "text": "哥伦比亚的总督对不对", "end": 78.06}, {"start": 78.06, "text": "所以老特你得加油啊", "end": 79.66}, {"start": 79.66, "text": "这会挺脏挺累的加油吧啊", "end": 82.66}, {"start": 82.66, "text": "这个路彪啊你得抓紧时间了", "end": 84.46}, {"start": 84.46, "text": "都等不及了", "end": 85.24}, {"start": 85.24, "text": "都个村口排好队等着迎接你呢", "end": 87.1}, {"start": 87.1, "text": "你啊别舍不得花钱", "end": 88.4}, {"start": 88.4, "text": "那将来的游泳有的是对不对", "end": 90.2}, {"start": 90.2, "text": "定制一套好一点的总督制服啊", "end": 92.5}, {"start": 92.5, "text": "打扮力争的走马上任抓紧时间走你", "end": 95.2}]}