{"url": "https://www.douyin.com/video/7599551224316235008", "link": false, "lang": "auto", "local_path": "", "segments": [{"start": 0.02, "text": "昨天37岁的ICU护士亚历克斯·普雷蒂在田田圈店外", "end": 5.02}, {"start": 5.02, "text": "手持手机靠近ICE执法现场", "end": 7.42}, {"start": 7.42, "text": "他没有携带任何武器", "end": 8.78}, {"start": 8.78, "text": "只是想拍摄执法过程", "end": 10.42}, {"start": 10.42, "text": "亲一名蒙面的ICE特工健壮立刻义勇而上", "end": 13.66}, {"start": 13.66, "text": "将他按在冰冷的地面上", "end": 15.54}, {"start": 15.54, "text": "双膝顶背四肢反减", "end": 17.74}, {"start": 17.74, "text": "完全控制住其行动", "end": 19.5}, {"start": 19.5, "text": "此时的普雷蒂毫无反抗能力", "end": 21.38}, {"start": 21.38, "text": "脸贴在鸡血里只能发出含糊的辩解", "end": 24.26}, {"start": 24.26, "text": "突然现场响起第一声响响", "end": 25.94}, {"start": 25.94, "text": "普雷蒂应声倒地", "end": 27.22}, {"start": 27.22, "text": "但ICE特工并未停手", "end": 29.1}, {"start": 29.18, "text": "其中一人特意上前", "end": 30.66}, {"start": 30.66, "text": "对着已经失去行动能力的他", "end": 33.06}, {"start": 33.06, "text": "补射了四到五枪", "end": 34.42}, {"start": 34.42, "text": "直到确认其彻底死亡才罢手", "end": 36.74}, {"start": 36.74, "text": "事后国土安全部为掩盖暴行", "end": 39.22}, {"start": 39.22, "text": "发布了一张汽车座椅上的手枪照片", "end": 41.78}, {"start": 41.78, "text": "谎称普雷蒂持枪暴力反抗", "end": 44.34}, {"start": 44.34, "text": "却始终无法解释为何现场视频中", "end": 46.9}, {"start": 46.9, "text": "他手中只有手机也无法说明", "end": 49.26}, {"start": 49.26, "text": "所谓的自卫为何需要在对方倒地后补枪", "end": 52.42}, {"start": 52.42, "text": "更荒谬的是", "end": 53.26}, {"start": 53.26, "text": "普雷蒂不仅是美国的公民", "end": 54.98}, {"start": 54.98, "text": "还持有合法持枪许可", "end": 56.78}, {"start": 56.78, "text": "无任何犯罪记录", "end": 58.26}, {"start": 58.26, "text": "他就死扶枪的双手", "end": 59.74}, {"start": 59.74, "text": "最终倒在了执法者的枪口下", "end": 61.78}, {"start": 61.78, "text": "涉事特供杀人后没有停留", "end": 63.54}, {"start": 63.54, "text": "直接撤离现场", "end": 64.66}, {"start": 64.66, "text": "留下满地的鲜血和愤怒的民众", "end": 66.98}, {"start": 66.98, "text": "正如周长沃尔兹质问的那样", "end": 68.94}, {"start": 68.94, "text": "你们杀了一个人", "end": 70.1}, {"start": 70.1, "text": "然后就这么走了", "end": 71.46}, {"start": 71.46, "text": "在美国的历史上", "end": 72.7}, {"start": 72.7, "text": "有没有先例是像你们这样", "end": 74.58}, {"start": 74.58, "text": "可以一走了之的", "end": 76.46}, {"start": 76.46, "text": "20号一个五岁男童", "end": 77.98}, {"start": 77.98, "text": "利亚姆拉莫斯背着书包", "end": 79.98}, {"start": 79.98, "text": "正和父亲在家门口准备出行", "end": 82.22}, {"start": 82.22, "text": "IC特供突然出现", "end": 83.66}, {"start": 83.66, "text": "他们的目标是利亚姆的父亲", "end": 85.5}, {"start": 85.5, "text": "一个正在依法申请相关权益", "end": 88.14}, {"start": 88.14, "text": "并无递解出境令的移民", "end": 90.42}, {"start": 90.42, "text": "但这些特供没有按程序执法", "end": 92.22}, {"start": 92.22, "text": "反而一把将利亚姆", "end": 93.34}, {"start": 93.34, "text": "从父亲身边拽过来", "end": 94.66}, {"start": 94.66, "text": "推到家门口让孩子伸手敲门", "end": 96.86}, {"start": 96.86, "text": "特供们躲在利亚姆身后", "end": 98.54}, {"start": 98.54, "text": "把这个年幼的孩子", "end": 99.66}, {"start": 99.66, "text": "当做人肉盾牌和引诱工具", "end": 101.66}, {"start": 101.66, "text": "全然不顾孩子的恐惧哭闹", "end": 103.58}, {"start": 103.58, "text": "也无视孩子父亲不要开门的", "end": 105.7}, {"start": 105.7, "text": "哭喊恳求", "end": 106.82}, {"start": 106.82, "text": "旁观者试图上前照看利亚姆", "end": 109.1}, {"start": 109.1, "text": "却被特供粗暴推开", "end": 110.58}, {"start": 110.58, "text": "最终利亚姆和父亲被一同拘捕", "end": 112.9}, {"start": 112.9, "text": "送往德州的移民拘留中心", "end": 114.86}, {"start": 114.94, "text": "一个本该在幼儿园嬉笑打闹的孩子", "end": 117.54}, {"start": 117.54, "text": "在毫无过错的情况下", "end": 119.34}, {"start": 119.34, "text": "成了ICE执法的战利品", "end": 121.42}, {"start": 121.42, "text": "在陌生的拘留所里承受着", "end": 122.9}, {"start": 122.9, "text": "不属于他的恐惧", "end": 124.3}, {"start": 124.3, "text": "而明州教育部门证实", "end": 126.62}, {"start": 126.62, "text": "利亚姆是当地四名", "end": 128.1}, {"start": 128.1, "text": "被拘学生中年龄最小的一位", "end": 130.66}, {"start": 130.66, "text": "22日下午1点", "end": 132.02}, {"start": 132.02, "text": "一名两岁的厄瓜多尔女童", "end": 134.02}, {"start": 134.02, "text": "和父亲从商店返家", "end": 135.34}, {"start": 135.34, "text": "刚到自家后院车道", "end": 136.86}, {"start": 136.86, "text": "ICE特供便毫无征兆地闯入", "end": 139.02}, {"start": 139.02, "text": "他们没有出示任何呆布林", "end": 140.82}, {"start": 140.82, "text": "直接砸破了汽车玻璃窗", "end": 142.62}, {"start": 142.66, "text": "从父亲怀里硬生生地抢走了女童", "end": 144.9}, {"start": 144.9, "text": "孩子吓得全程哭闹不止", "end": 146.66}, {"start": 146.66, "text": "而这些执法者面无表情", "end": 148.34}, {"start": 148.34, "text": "将父女二人强行扣押", "end": 149.94}, {"start": 149.94, "text": "当晚联邦法官经过审理", "end": 152.34}, {"start": 152.34, "text": "认定女童无任何犯罪记录", "end": 154.66}, {"start": 154.66, "text": "面临遭受不可挽回伤害的风险", "end": 157.34}, {"start": 157.34, "text": "下达了紧急指令", "end": 158.5}, {"start": 158.5, "text": "要求ICE在晚9点30分前释放女童", "end": 161.5}, {"start": 161.5, "text": "但是ICE特供完全无视司法权威", "end": 164.34}, {"start": 164.34, "text": "公然违抗法官令状", "end": 165.82}, {"start": 165.82, "text": "在截止时间前将父女二人送上了", "end": 168.34}, {"start": 168.34, "text": "飞往德州移民拘留中心的飞机", "end": 170.9}, {"start": 170.9, "text": "直到后续舆论压力升级", "end": 172.74}, {"start": 172.74, "text": "ICE才被迫将女童空运回明尼苏大州", "end": 175.94}, {"start": 175.94, "text": "交由其母亲监护", "end": 177.26}, {"start": 177.26, "text": "但孩子的父亲至今仍被挤押", "end": 179.06}, {"start": 179.06, "text": "一个完整的家庭被强行拆散", "end": 181.3}, {"start": 181.3, "text": "之所以会发生这一切的暴行", "end": 183.26}, {"start": 183.26, "text": "其实背后是ICE一份见不得光的内部备忘录", "end": 186.46}, {"start": 186.46, "text": "这份由时任ICE代理局长签署的文件", "end": 189.3}, {"start": 189.3, "text": "公然授权特供仅凭行政令状", "end": 192.02}, {"start": 192.02, "text": "即可闯入居民住所", "end": 193.42}, {"start": 193.42, "text": "执行驱逐", "end": 194.38}, {"start": 194.38, "text": "甚至可动用武力", "end": 195.74}, {"start": 195.74, "text": "完全违反了美国宪法第四修正案中", "end": 198.46}, {"start": 198.46, "text": "禁止不合理搜查与扣押的规定", "end": 200.78}, {"start": 200.78, "text": "备忘录被秘密传达", "end": 202.14}, {"start": 202.14, "text": "要求月后归还", "end": 203.46}, {"start": 203.46, "text": "新招募的特工更是被口头告知", "end": 205.74}, {"start": 205.74, "text": "遵循这份潜规则", "end": 207.18}, {"start": 207.18, "text": "而非书面培训材料", "end": 208.9}, {"start": 208.9, "text": "正是这份月全备忘录", "end": 210.38}, {"start": 210.38, "text": "让ICE特工有恃无恐", "end": 212.22}, {"start": 212.22, "text": "他们可以不持令状强闯民宅", "end": 214.22}, {"start": 214.22, "text": "可以无视法官令状掳走右统", "end": 216.14}, {"start": 216.14, "text": "可以随意枪杀公民后扬长而去", "end": 218.62}, {"start": 218.62, "text": "这一切的背后都是那个疯狂的地产商", "end": 221.18}, {"start": 221.18, "text": "他可以去别的国家", "end": 222.34}, {"start": 222.34, "text": "公然把别人的总统掳走", "end": 223.9}, {"start": 223.9, "text": "也可以对自己的人民肆意践踏屠杀", "end": 226.62}, {"start": 226.62, "text": "甚至两岁的孩子他都不放过", "end": 228.5}, {"start": 228.5, "text": "因为在他的眼里权力就是法律", "end": 230.54}, {"start": 230.54, "text": "暴力就是规则", "end": 231.7}, {"start": 231.7, "text": "至于文明让职人们自己裹在小脑上吧", "end": 234.7}]}